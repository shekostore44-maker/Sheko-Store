# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only (admin tasks). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until launch so Google does not index preview deployments.
NEXT_PUBLIC_SITE_INDEXABLE=false
